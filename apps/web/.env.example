# Must match where the API listens (default port 4000). Restart Vite after changing.
VITE_API_URL=http://localhost:4000
VITE_MAIN_APP_ORIGIN=http://localhost:5173

# Active local stack: opBNB Testnet (5611) — matches deployments/opbnb-testnet-nftaix-stack.json
VITE_OPBNB_CHAIN_ID=5611
VITE_OPBNB_RPC_URL=https://opbnb-testnet-rpc.bnbchain.org
VITE_OPBNB_EXPLORER_URL=https://testnet.opbnbscan.com

# Contract addresses come from API /api/chain/status (apps/api/.env).

# --- opBNB Mainnet (204) ---
# VITE_OPBNB_CHAIN_ID=204
# VITE_OPBNB_RPC_URL=https://opbnb-mainnet-rpc.bnbchain.org
# VITE_OPBNB_EXPLORER_URL=https://opbnb.bscscan.com

# --- Local Hardhat (31337) ---
# VITE_OPBNB_CHAIN_ID=31337
# VITE_OPBNB_RPC_URL=http://127.0.0.1:8545
