NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nftaix
JWT_ACCESS_SECRET=replace_with_long_secret
JWT_REFRESH_SECRET=replace_with_long_secret
# Must match browser origin(s) exactly (scheme + host + port). Comma-separate for user app + admin:
# CORS_ORIGIN=http://localhost:5173,http://localhost:5174
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
REDIS_URL=redis://localhost:6379
# Optional: cuid of User row that receives activation creator % (10%)
# PROJECT_CREATOR_USER_ID=
# EVM — active stack: opBNB Testnet (5611). See deployments/opbnb-testnet-nftaix-stack.json
#
# opBNB Testnet (local / staging):
CHAIN_RPC_URL=https://opbnb-testnet-rpc.bnbchain.org
CHAIN_ID=5611
#
# opBNB Mainnet (production):
# CHAIN_RPC_URL=https://opbnb-mainnet-rpc.bnbchain.org
# CHAIN_ID=204
#
CHAIN_PRIVATE_KEY=replace_with_private_key
# Optional: Registration / GlobalPool / Treasury owner key for admin ops
# CONTRACT_ADMIN_PRIVATE_KEY=

# NFTAIX 6-contract stack (+ USDT) — copy from deployments/opbnb-testnet-nftaix-stack.json
# USDT_CONTRACT_ADDRESS=0xCFBd8863f4DdB18bAeF44F3f1feE65F37C97bb8a
# REGISTRATION_CONTRACT_ADDRESS=0xE1e2cBaeE72Dbb421aeF27b90fEC7E36B51aF9dD
# MARKETPLACE_CONTRACT_ADDRESS=0xdfCFbDd64e92366e2212Da926Fa50533c8d886bc
# REWARDS_CONTRACT_ADDRESS=0xEF0421Cb6c949b8ADDb668c3fE211f939101528F
# GLOBAL_POOL_CONTRACT_ADDRESS=0x68c459D3Dd172919e8401d17F95f064a2a826d03
# TREASURY_CONTRACT_ADDRESS=0xDA1d895bbEA1c43032Ac3325794CaD893beEB711
# LIQUIDITY_MANAGER_CONTRACT_ADDRESS=0xA2f59CB5b13565a78F775D5A50b1883C1Ec15a50
# USDT_ADDRESS= (same as USDT_CONTRACT_ADDRESS)

# Optional: fallback sponsor when rootSponsor resolution fails
# REGISTRATION_REFERRER_FALLBACK=

# Optional: executor key pays gas for NFTMarketplace runBot / botBuy
# AUTO_TRADE_EXECUTOR_PRIVATE_KEY=
# Optional: marketplace owner key for setBot (defaults to CHAIN_PRIVATE_KEY)
# MARKETPLACE_OWNER_PRIVATE_KEY=
# Primary buys per keeper run. Use 0 for resale-only bot.
# AUTO_TRADE_MAX_PRIMARY_BUYS_PER_RUN=0
# Resale purchases per keeper run.
# AUTO_TRADE_MAX_SECONDARY_TRADES_PER_RUN=100
# Rolling daily trading window + auto-trade bot cadence (hours). Default 15.
# TRADING_PERIOD_HOURS=15
# BOT_SEQUENTIAL_MAX_PURCHASES_PER_USER=50
# AUTO_TRADE_KEEPER_INTERVAL_HOURS=15
# LEGACY_AUTO_TRADE_KEEPER=false
# BOT_SEQUENTIAL_PRIMARY_FALLBACK=true
# ADMIN_MANUAL_TRADE_MAX_PURCHASES=50
# ADMIN_MANUAL_TRADE_PRIMARY_FALLBACK=true

# Optional: resolve ipfs:// in tokenURI JSON (default https://ipfs.io/ipfs)
# NFT_IPFS_GATEWAY=https://ipfs.io/ipfs

USDT_DECIMALS=18
# Start indexing from your deployment block to avoid massive historical scans
# CHAIN_START_BLOCK=
# Optional: signs batch ERC20 airdrop transfers (POST /api/admin/airdrop/execute)
# AIRDROP_SIGNER_PRIVATE_KEY=

# Daily global pool: GlobalPool.distributeDay (owner key required)
# GLOBAL_POOL_ONCHAIN_PAYOUT_ENABLED=true
# GLOBAL_POOL_PAYOUT_PRIVATE_KEY=   # must be GlobalPool owner(); else CONTRACT_ADMIN_PRIVATE_KEY
# GLOBAL_POOL_PAYOUT_SOURCE=global_pool  # global_pool | wallet
# GLOBAL_POOL_BURN_WALLET_ADDRESS=  # optional; defaults to TREASURY_CONTRACT_ADDRESS

# eth_getLogs chunk size (public RPC often caps ~80 blocks; auto-halves on "limit exceeded")
# CHAIN_GET_LOGS_MAX_BLOCK_RANGE=80

# Optional: marketplace queue scan size (integer 20–300; invalid/non-numeric falls back to 160)
# MARKET_NFT_QUEUE_MAX_SCAN=160

# Default: real blockchain only (no DB "USDT" credit, no POST /packages/activate).
# Set to true only for legacy custodial demo (requires REGISTRATION_USDT_CREDIT).
# CUSTODIAL_USDT_ENABLED=false

# USDT credited on registration when CUSTODIAL_USDT_ENABLED=true
REGISTRATION_USDT_CREDIT=100
